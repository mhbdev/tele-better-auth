{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core"],
  "formatter": { "lineEnding": "auto" },
  "overrides": [
    {
      "includes": ["examples/**/*.ts", "examples/**/*.tsx", "test/**/*.tsx"],
      "linter": {
        "rules": {
          "correctness": { "noUndeclaredDependencies": "off" },
          "nursery": { "useTailwindSortedClasses": "off" },
          "performance": { "noJsxPropsBind": "off" }
        }
      }
    },
    {
      "includes": ["src/**/*.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "useDomQuerySelector": "off",
            "useImportsFirst": "off"
          }
        }
      }
    },
    {
      "includes": ["src/client.ts"],
      "linter": {
        "rules": {
          "style": { "useDomQuerySelector": "off" }
        }
      }
    }
  ],
  "linter": {
    "rules": {
      "style": {
        "useNumericSeparators": "off",
        "noNonNullAssertion": "off",
        "useNamingConvention": "off",
        "useFilenamingConvention": "off",
        "noMagicNumbers": "off",
        "useDefaultParameterLast": "off"
      },
      "suspicious": {
        "noExplicitAny": "off",
        "noEmptyBlockStatements": "off"
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": "off"
      },
      "performance": {
        "useTopLevelRegex": "off",
        "noDelete": "off"
      },
      "a11y": {
        "useButtonType": "off"
      }
    }
  }
}
