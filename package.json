{
  "name": "tele-better-auth",
  "version": "1.7.3",
  "description": "Telegram authentication plugin for Better Auth",
  "keywords": [
    "better-auth",
    "better-auth-plugin",
    "telegram",
    "telegram-login",
    "telegram-mini-apps",
    "authentication",
    "oauth",
    "plugin",
    "typescript"
  ],
  "homepage": "https://github.com/mhbdev/tele-better-auth#readme",
  "bugs": {
    "url": "https://github.com/mhbdev/tele-better-auth/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mhbdev/tele-better-auth.git"
  },
  "license": "MIT",
  "author": "mhbdev",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./client": {
      "import": {
        "types": "./dist/client.d.ts",
        "default": "./dist/client.js"
      },
      "require": {
        "types": "./dist/client.d.cts",
        "default": "./dist/client.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "skills"
  ],
  "scripts": {
    "build": "tsdown",
    "check:package": "node scripts/check-package.mjs",
    "dev": "tsdown --watch",
    "lint": "ultracite check",
    "lint:fix": "ultracite fix",
    "prepublishOnly": "npm run lint && npm run type-check && npm run build && npm run type-test && npm run test:coverage && npm run check:package",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "type-test": "tsc -p type-tests/tsconfig.json --noEmit"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,css}": [
      "npx ultracite fix"
    ]
  },
  "dependencies": {
    "jose": "6.2.15"
  },
  "devDependencies": {
    "@better-auth/core": "1.7.18",
    "@biomejs/biome": "2.6.6",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "@vitest/ui": "5.1.0",
    "better-auth": "1.7.18",
    "happy-dom": "21.0.4",
    "lint-staged": "17.6.0",
    "tsdown": "0.23.7",
    "typescript": "7.0.2",
    "ultracite": "8.1.1",
    "vitest": "5.1.0"
  },
  "peerDependencies": {
    "@better-auth/core": "^1.7.17",
    "better-auth": "^1.7.17"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
